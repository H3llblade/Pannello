#!/usr/bin/env bash
# Pubblica le modifiche sulla VPS.
#
#   ./deploy                 commit + push + aggiorna la VPS
#   ./deploy "messaggio"     come sopra, con messaggio di commit personalizzato
#   ./deploy --setup         prima installazione sulla VPS (nginx, HTTPS, servizio)
#
# Configurazione in deploy.env (vedi deploy.env.example).
set -euo pipefail
cd "$(dirname "$0")"

c() { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
die() { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

[ -f deploy.env ] || die "Manca deploy.env: copia deploy.env.example in deploy.env e compila i valori."
# shellcheck disable=SC1091
source deploy.env
: "${VPS_HOST:?VPS_HOST mancante in deploy.env}"
VPS_USER="${VPS_USER:-root}"
VPS_PORT="${VPS_PORT:-22}"
APP_DIR="${APP_DIR:-Pannello}"   # relativo alla home dell'utente SSH
DOMAIN="${DOMAIN:-pannello.devicloud.me}"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
REPO_URL="${REPO_URL:-$(git remote get-url origin)}"

TARGET="$VPS_USER@$VPS_HOST"
[ "$VPS_USER" = root ] && SUDO="" || SUDO="sudo"
SSH=(ssh -p "$VPS_PORT" -o StrictHostKeyChecking=accept-new "$TARGET")

ensure_key() {
  [ -f ~/.ssh/id_ed25519 ] || { c "Genero una chiave SSH"; ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519 -q; }
  if ! "${SSH[@]}" -o BatchMode=yes true 2>/dev/null; then
    c "Copio la chiave SSH sulla VPS (ti verrà chiesta la password una volta)"
    ssh-copy-id -p "$VPS_PORT" -i ~/.ssh/id_ed25519.pub "$TARGET"
  fi
}

push_changes() {
  if [ -n "$(git status --porcelain)" ]; then
    git add -A
    git commit -q -m "${1:-Aggiornamento pannello $(date '+%Y-%m-%d %H:%M')}"
    c "Commit creato: $(git log -1 --pretty=%s)"
  fi
  c "Push su origin/$BRANCH"
  git push -q origin "$BRANCH"
}

if [ "${1:-}" = "--setup" ]; then
  ensure_key
  push_changes "Setup iniziale"
  c "Installo il pannello su $TARGET"
  "${SSH[@]}" "$SUDO env REPO_URL='$REPO_URL' BRANCH='$BRANCH' APP_DIR='$APP_DIR' DOMAIN='$DOMAIN' EMAIL='${LETSENCRYPT_EMAIL:-}' bash -s" < scripts/setup-vps.sh
  c "Fatto → https://$DOMAIN"
  exit 0
fi

push_changes "${1:-}"
c "Aggiorno la VPS"
"${SSH[@]}" "cd '$APP_DIR' && git fetch -q origin '$BRANCH' && git reset -q --hard 'origin/$BRANCH' && $SUDO systemctl restart pannello && git log -1 --pretty='  online: %h %s'"
c "Deploy completato → https://$DOMAIN"
