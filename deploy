#!/usr/bin/env bash
# Da lanciare SULLA VPS, dentro ~/Pannello: scarica da GitHub l'ultima versione e la mette online.
#
#   ./deploy            aggiorna (alla prima esecuzione installa anche nginx, HTTPS e il servizio)
#   ./deploy --setup    rifà l'installazione completa (es. dopo aver sistemato il DNS)
set -euo pipefail
cd "$(dirname "$0")"

c() { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }

BRANCH=main

# 1) Scarica le modifiche, poi riavvia lo script aggiornato (potrebbe essere cambiato anche lui)
if [ "${1:-}" != "--pulled" ]; then
  c "Scarico le modifiche da GitHub"
  git fetch -q origin "$BRANCH"
  git reset -q --hard "origin/$BRANCH"
  git log -1 --pretty='  versione: %h %s (%cr)'
  exec "$0" --pulled "${1:-}"
fi

# 2) Installa (prima volta o --setup) oppure riavvia soltanto
if [ "${2:-}" = "--setup" ] || [ ! -f /etc/systemd/system/pannello.service ]; then
  c "Installazione (nginx, HTTPS, servizio)"
  sudo APP_DIR="$PWD" RUN_USER="$(id -un)" bash scripts/setup-vps.sh
else
  sudo systemctl restart pannello
fi

c "Online → https://pannello.devicloud.me"
