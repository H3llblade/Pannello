# Copia questo file in deploy.env (non viene committato) e compila i valori.
VPS_HOST=1.2.3.4            # IP o hostname della VPS
VPS_USER=root               # utente SSH (root o con sudo)
VPS_PORT=22
APP_DIR=Pannello            # cartella sulla VPS (relativa alla home, es. /root/Pannello)
DOMAIN=pannello.devicloud.me
LETSENCRYPT_EMAIL=          # opzionale: email per gli avvisi di scadenza del certificato
# REPO_URL=                 # se il repo è privato: https://<token>@github.com/H3llblade/Pannello.git
